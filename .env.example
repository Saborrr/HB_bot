# Telegram
BOT_TOKEN=replace-with-token-from-BotFather
ALLOWED_USERS=123456789
NOTIFY_CHAT_IDS=123456789

# Database: SQLite for a small installation
DATABASE_URL=sqlite+aiosqlite:///./data/hb_bot.sqlite3

# Birthday notifications
TIMEZONE=Europe/Moscow
NOTIFY_TIME=09:00
REMINDER_DAYS=7,1,0
UPCOMING_DAYS=7

# Runtime
LOG_LEVEL=INFO

# Docker Compose PostgreSQL credentials.
# Use only URL-safe characters (letters, digits, -, _, . and ~) in the password.
POSTGRES_DB=hb_bot
POSTGRES_USER=hb_bot
POSTGRES_PASSWORD=replace-with-a-long-random-password
